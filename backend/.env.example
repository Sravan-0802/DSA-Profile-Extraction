# ---------------------------------------------------------------------------
# Resume Intelligence Tool — backend configuration
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# Mistral AI keys. Provide ONE of:
#   - a single key via MISTRAL_API_KEY, OR
#   - multiple keys via MISTRAL_API_KEY_1, MISTRAL_API_KEY_2, ... (round-robin)
# Multiple keys raise throughput and reduce 429 rate-limit stalls.
MISTRAL_API_KEY=
# MISTRAL_API_KEY_1=
# MISTRAL_API_KEY_2=
# MISTRAL_API_KEY_3=

# Mistral model to use.
MISTRAL_MODEL=mistral-large-latest

# GitHub token(s) for the "GitHub Analysis" mode. Anonymous GitHub API access is
# capped at 60 requests/hour, which is far too low (that mode makes many calls per
# candidate). A personal access token raises the limit to 5000/hr. Provide ONE of:
#   - a single token via GITHUB_TOKEN, OR
#   - multiple tokens via GITHUB_TOKEN_1, GITHUB_TOKEN_2, ... (round-robin)
# A fine-grained or classic token with public-repo read scope is sufficient.
GITHUB_TOKEN=
# GITHUB_TOKEN_1=
# GITHUB_TOKEN_2=

# Default + maximum number of resumes processed concurrently.
DEFAULT_CONCURRENCY=8
MAX_CONCURRENCY=20

# OCR fallback for scanned/image resumes. Requires the Tesseract binary.
# If Tesseract is not installed, leave this as-is; normal text PDFs still work.
ENABLE_OCR=true
# Optional explicit path to the tesseract executable (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated list of allowed CORS origins (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
