# Replit: one public port only (publish rejects multiple external ports).
run = "bash scripts/start.sh"
modules = ["python-3.12", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["bash", "scripts/start.sh"]
# Autoscale publishes on Starter; Reserved VM keeps in-memory jobs across idle
# periods but needs Core/Pro/Enterprise. Prefer Autoscale unless you need
# long-lived job state between idle pauses.
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
