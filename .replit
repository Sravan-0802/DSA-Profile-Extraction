# Replit: one public port only (publish rejects multiple external ports).
run = "bash scripts/start.sh"
modules = ["python-3.12", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["bash", "scripts/start.sh"]
# Autoscale publishes on Starter; Reserved VM keeps in-memory jobs across idle
# periods but needs Core/Pro/Enterprise. Prefer Autoscale unless you need
# long-lived job state between idle pauses.
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
CORS_ORIGINS = "*"
DEFAULT_CONCURRENCY = "8"
ENABLE_OCR = "false"
MAX_CONCURRENCY = "20"
MISTRAL_MODEL = "mistral-large-latest"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
